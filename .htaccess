Options -Indexes
DirectoryIndex index.php
RewriteEngine On

# 允许共享主机在没有 HTTPS 的情况下直接运行；所有页面仍由单一入口处理。
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

<FilesMatch "^(\.env|config\.php|.*\.sqlite|.*\.log)$">
    Require all denied
</FilesMatch>
